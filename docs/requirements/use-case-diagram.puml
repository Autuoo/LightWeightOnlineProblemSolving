@startuml OJ-UseCase
' 轻量在线判题系统 OJ —— 用例图
' 渲染方式：PlantUML 在线编辑器、VS Code PlantUML 插件，或 plantuml.jar
left to right direction
skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam shadowing false

actor "学生" as Student
actor "管理员/教师" as Admin
actor "阿里云百炼\n(AI 服务)" as AI

rectangle "轻量在线判题系统 OJ" {
  usecase "UC-01 注册账号" as UC01
  usecase "UC-02 登录与退出" as UC02
  usecase "UC-03 浏览与检索题目" as UC03
  usecase "UC-04 查看题目详情与样例" as UC04
  usecase "UC-05 编写并提交代码" as UC05
  usecase "UC-06 查看评测结果与提交详情" as UC06
  usecase "UC-07 自定义输入运行" as UC07
  usecase "UC-08 加载历史提交代码" as UC08
  usecase "UC-09 查看排行榜" as UC09
  usecase "UC-10 个人中心与刷题统计" as UC10
  usecase "UC-11 配置 AI 助教并提问" as UC11
  usecase "UC-12 题目管理" as UC12
  usecase "UC-12a 导入测试点" as UC12a
  usecase "UC-13 用户管理" as UC13
  usecase "UC-13a 重置密码" as UC13a
  usecase "UC-14 切换主题" as UC14
  usecase "UC-15 参加比赛" as UC15
  usecase "UC-16 比赛管理" as UC16
}

Student --> UC01
Student --> UC02
Admin --> UC02
Student --> UC03
Student --> UC04
Student --> UC05
Student --> UC06
Admin --> UC06
Student --> UC07
Student --> UC08
Student --> UC09
Student --> UC10
Student --> UC11
Admin --> UC12
Admin --> UC13
Student --> UC14
Admin --> UC14
Student --> UC15
Admin --> UC16

UC01 .> UC02 : <<extend>>
UC05 ..> UC06 : <<include>>
UC07 ..> UC05 : <<extend>>
UC08 ..> UC05 : <<extend>>
UC12 ..> UC12a : <<include>>
UC13 ..> UC13a : <<include>>
UC15 ..> UC05 : <<extend>>
UC11 --> AI

note right of UC07
  使用学生自己输入的 stdin，
  不读取隐藏测试点，
  不产生提交记录。
end note

note bottom of UC06
  学生只能查看本人提交；
  管理员可查看全部提交。
end note
@enduml